# ===================================================
# HIREX — SERVER ENVIRONMENT CONFIGURATION
# Smarter Hiring. Better Talent.
# ===================================================

# Core Application Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/hrflow

# ---------------------------------------------------
# 1. AI — Google Gemini API
# ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------
# 2. Jobs — Authorized Naukri Partner API Access
# (Note: Never scrape HTML; only use authorized partner API credentials)
# ---------------------------------------------------
NAUKRI_API_KEY=your_naukri_api_key_here
NAUKRI_CLIENT_ID=your_naukri_client_id_here
NAUKRI_CLIENT_SECRET=your_naukri_client_secret_here
NAUKRI_BASE_URL=https://api.naukri.com/v1

# ---------------------------------------------------
# 3. Jobs Fallback — Adzuna & JSearch Providers
# ---------------------------------------------------
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs/in/search

JSEARCH_API_KEY=your_jsearch_rapidapi_key_here

# ---------------------------------------------------
# 4. Location & Maps — Google Maps Platform APIs
# ---------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# ---------------------------------------------------
# 5. Authentication — Google & GitHub OAuth
# ---------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ---------------------------------------------------
# 6. Email Verification Service — Resend or SendGrid
# ---------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=onboarding@hirex.ai

# ---------------------------------------------------
# 7. Learning — YouTube Data API v3
# ---------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
